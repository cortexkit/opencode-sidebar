{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*"],
  "exclude": ["test/**/*", "dist/"]
}
